# MQTT bridge for edge-device camera mapping sync
# Enable this on PA when it needs to consume mapping/request and publish mapping/response.
MQTT_BRIDGE_ENABLED=false
MQTT_BRIDGE_HOST=localhost
MQTT_BRIDGE_PORT=1883
# Example: aibox/{orgId}/{locationId}/{serialNumber}
MQTT_BRIDGE_TOPIC_NAMESPACE=
MQTT_BRIDGE_CLIENT_ID=ai-be-pa-bridge
